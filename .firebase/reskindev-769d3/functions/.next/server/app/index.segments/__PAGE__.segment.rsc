            <div class="service-card">
                <h4>⚡ Framework Expertise</h4>
                <p>Seamless development using industry standard stacks: ARKit, ARCore, RealityKit, and Vuforia.</p>
            </div>
        </div>
    </section>

    <!-- Call to Action -->
    <section class="cta-box">
        <h3>Ready to Build Your Vision?</h3>
        <p>
            Share your project concept, target timeline, and budget. <br>
    </section>

</div>

</body>
