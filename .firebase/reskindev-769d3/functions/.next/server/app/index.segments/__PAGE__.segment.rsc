</div>9:T20f8,<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Professional Video Editing Service</title>
    <style>
        :root {
            --bg-color: #0f0c1b;
            --card-bg: rgba(255, 255, 255, 0.04);
            --card-border: rgba(255, 255, 255, 0.08);
            --accent-gradient: linear-gradient(135deg, #ff007f, #7928ca);
            --text-main: #f8fafc;
            --text-muted: #cbd5e1;
            --font-family: 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }

        .video-editor-profile {
            background-color: var(--bg-color);
            color: var(--text-main);
            font-family: var(--font-family);
            max-width: 900px;
            margin: 0 auto;
            padding: 40px 24px;
            border-radius: 24px;
            box-sizing: border-box;
            background-image: 
                radial-gradient(circle at 15% 50%, rgba(121, 40, 202, 0.1) 0%, transparent 50%),
                radial-gradient(circle at 85% 30%, rgba(255, 0, 127, 0.1) 0%, transparent 50%);
        }

        .hero-header {
            text-align: center;
            margin-bottom: 40px;
        }

        .badge-wrap {
            display: flex;
            justify-content: center;
            gap: 12px;
            margin-bottom: 20px;
            flex-wrap: wrap;
        }

        .badge {
            display: inline-block;
            padding: 6px 16px;
            background: rgba(121, 40, 202, 0.2);
            border: 1px solid rgba(121, 40, 202, 0.5);
            color: #d8b4fe;
            border-radius: 30px;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 1px;
            text-transform: uppercase;
        }

        .hero-title {
            font-size: 2.5rem;
            font-weight: 800;
            line-height: 1.2;
            margin: 0 0 16px 0;
            background: var(--accent-gradient);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-desc {
            color: var(--text-muted);
            font-size: 1.1rem;
            line-height: 1.6;
            max-width: 700px;
            margin: 0 auto;
        }

        .tools-used {
            margin-top: 16px;
            font-size: 0.95rem;
            color: #a78bfa;
            font-weight: 600;
        }

        .section-wrap {
            margin-bottom: 40px;
        }

        .section-title {
            font-size: 1.6rem;
            margin-bottom: 24px;
            color: #ffffff;
            font-weight: 700;
            display: inline-block;
            border-bottom: 3px solid #ff007f;
            padding-bottom: 4px;
        }

        .grid-2col {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
            gap: 20px;
        }

        .list-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 16px;
            padding: 24px;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .list-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 8px 30px rgba(121, 40, 202, 0.15);
            border-color: rgba(255, 0, 127, 0.3);
        }

        .list-card h3 {
            margin: 0 0 16px 0;
            color: #f8fafc;
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .feature-list {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .feature-list li {
            position: relative;
            padding-left: 28px;
            margin-bottom: 12px;
            color: var(--text-muted);
            font-size: 0.95rem;
            line-height: 1.4;
        }

        .feature-list li::before {
            content: "✨";
            position: absolute;
            left: 0;
            top: -2px;
            font-size: 1rem;
        }

        .why-me-card {
            background: linear-gradient(135deg, rgba(255, 0, 127, 0.1), rgba(121, 40, 202, 0.1));
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 16px;
            padding: 30px;
            text-align: center;
            margin-top: 20px;
        }

        .why-me-card h3 {
            margin: 0 0 12px 0;
            font-size: 1.4rem;
            color: #ffffff;
        }

        .why-me-card p {
            color: var(--text-muted);
            font-size: 1rem;
            line-height: 1.6;
            margin: 0;
        }

        .cta-container {
            text-align: center;
            margin-top: 48px;
        }

        .cta-button {
            display: inline-block;
            padding: 16px 40px;
            background: var(--accent-gradient);
            color: #ffffff;
            text-decoration: none;
            font-size: 1.1rem;
            font-weight: 700;
            border-radius: 50px;
            transition: opacity 0.2s ease, transform 0.2s ease;
            box-shadow: 0 10px 25px rgba(255, 0, 127, 0.4);
        }

        .cta-button:hover {
            opacity: 0.9;
            transform: scale(1.05);
        }

        .availability {
            display: inline-block;
            margin-top: 16px;
            font-size: 0.9rem;
            color: #d8b4fe;
            background: rgba(255, 255, 255, 0.05);
            padding: 6px 16px;
            border-radius: 20px;
        }
    </style>
</head>
<body>

<div class="video-editor-profile">
    
    <!-- Hero Header -->
    <header class="hero-header">
        <div class="badge-wrap">
            <span class="badge">6+ Years Experience</span>
            <span class="badge">YouTube Creator</span>
        </div>
        <h1 class="hero-title">Professional YouTube Video Editing</h1>
        <p class="hero-desc">
            Make your videos stand out and captivate your audience. Whether you're a beginner or a seasoned creator, I’m here to ensure your videos shine.
        </p>
        <div class="tools-used">
            Final Cut Pro | Premiere Pro | After Effects | CapCut
        </div>
    </header>

    <!-- Services & Inclusions Grid -->
    <div class="grid-2col section-wrap">
        
        <!-- Services Provided -->
        <div class="list-card">
            <h3>🎬 Services I Provide</h3>
            <ul class="feature-list">
                <li>YouTube Video Editing</li>
                <li>Travel & Vlog Videos</li>
                <li>Podcast Editing</li>
                <li>Gaming Highlights</li>
                <li>Documentaries</li>
                <li>Wedding Videos</li>
                <li>Real Estate Clips</li>
                <li>Green Screen Edits</li>
                <li>All Social Media Formats (TikTok/Reels/Shorts)</li>
            </ul>
        </div>

        <!-- What's Included -->
        <div class="list-card">
            <h3>⚙️ What's Included</h3>
            <ul class="feature-list">
                <li>Color Grading & Correction</li>
                <li>Trimming, Cutting & Joining Clips</li>
                <li>Titles & Subtitles Creation</li>
                <li>Audio Syncing & Mixing</li>
                <li>Animating Logos/Watermarks</li>
                <li>Green Screen Keying</li>
                <li>Slideshows & Montages</li>
                <li>GoPro Footage Edits</li>
                <li>Multicam Editing</li>
                <li>Slow Motion & Speed Ramping</li>
                <li>4K & 1080p High-Quality Output</li>
            </ul>
        </div>

    </div>

    <!-- Why Choose Me -->
    <div class="why-me-card">
        <h3>💡 Why Choose Me?</h3>
        <p>
            As a YouTube content creator myself, I understand exactly what viewers want and how the algorithm works. I've collaborated with numerous YouTubers to elevate their video content, increase audience retention, and bring their creative visions to life.
        </p>
    </div>

    <!-- Call to Action -->
    <div class="cta-container">
        <a href="#contact" class="cta-button">✨ Let’s Work Together! ✨</a>
        <br>
        <span class="availability">🟢 Online 24/7 to serve your needs! Feel free to inbox me.</span>
    </div>

</div>

</body>
</html>f:X
