    <title>VPN App Development Service</title>
    <style>
        :root {
            --bg-color: #0b1120;
            --card-bg: rgba(30, 41, 59, 0.7);
            --card-border: rgba(255, 255, 255, 0.1);
            --primary-accent: #38bdf8;
            --secondary-accent: #818cf8;
            --green-accent: #34d399;
            --text-main: #f8fafc;
            --text-muted: #94a3b8;
