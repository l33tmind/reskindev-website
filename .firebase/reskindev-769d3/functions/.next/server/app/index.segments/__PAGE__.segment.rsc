            font-family: var(--font-family);
            max-width: 900px;
            margin: 0 auto;
            padding: 40px 24px;
            border-radius: 20px;
            box-sizing: border-box;
        }

        .hero-section {
            text-align: center;
            margin-bottom: 40px;
        }

        .badge-container {
            display: flex;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
            margin-bottom: 16px;
        }

        .badge {
            display: inline-block;
            padding: 6px 14px;
            background: rgba(56, 189, 248, 0.15);
            border: 1px solid var(--primary-accent);
            color: var(--primary-accent);
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 0.5px;
        }

        .badge.green {
            background: rgba(52, 211, 153, 0.15);
            border-color: var(--green-accent);
            color: var(--green-accent);
        }

        .hero-title {
            font-size: 2.2rem;
            font-weight: 800;
            line-height: 1.3;
            margin: 0 0 16px 0;
            background: linear-gradient(135deg, #ffffff 30%, var(--primary-accent));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero-description {
            color: var(--text-muted);
            font-size: 1.05rem;
            line-height: 1.6;
            max-width: 750px;
            margin: 0 auto;
        }

        .stats-box {
            background: linear-gradient(135deg, rgba(56, 189, 248, 0.1), rgba(129, 140, 248, 0.1));
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 16px 24px;
            margin: 24px auto 0 auto;
            display: inline-block;
            color: #ffffff;
            font-size: 0.95rem;
        }

        .section-title {
            font-size: 1.5rem;
            margin: 40px 0 20px 0;
            color: #ffffff;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .features-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 16px;
        }

        .feature-card {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            border-radius: 12px;
            padding: 18px;
            display: flex;
            align-items: flex-start;
            gap: 12px;
            transition: transform 0.2s ease, border-color 0.2s ease;
        }

        .feature-card:hover {
            transform: translateY(-2px);
            border-color: rgba(56, 189, 248, 0.4);
        }

        .feature-icon {
            font-size: 1.2rem;
            background: rgba(255, 255, 255, 0.05);
            padding: 8px;
            border-radius: 8px;
            line-height: 1;
        }

        .feature-text {
            font-size: 0.95rem;
            color: var(--text-main);
            font-weight: 500;
            line-height: 1.4;
        }

        .admin-section {
            background: rgba(15, 23, 42, 0.6);
            border: 1px dashed rgba(129, 140, 248, 0.3);
            border-radius: 16px;
            padding: 24px;
            margin-top: 30px;
        }

        .admin-list {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 12px;
            margin-top: 16px;
        }

        .admin-item {
            background: var(--card-bg);
            border: 1px solid var(--card-border);
            padding: 12px 16px;
            border-radius: 8px;
            font-size: 0.9rem;
            color: var(--text-main);
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .cta-box {
            background: linear-gradient(135deg, #0284c7, #4f46e5);
            border-radius: 16px;
            padding: 32px;
            text-align: center;
            margin-top: 40px;
        }

        .cta-box h3 {
            margin: 0 0 8px 0;
            font-size: 1.5rem;
            color: #ffffff;
        }

        .cta-box p {
            color: rgba(255, 255, 255, 0.9);
            font-size: 0.95rem;
            margin: 0 0 20px 0;
        }

        .cta-button {
            display: inline-block;
            padding: 12px 30px;
            background: #ffffff;
            color: #0f172a;
            text-decoration: none;
            font-weight: 700;
            border-radius: 8px;
            transition: opacity 0.2s ease, transform 0.2s ease;
        }

        .cta-button:hover {
            opacity: 0.95;
            transform: scale(1.02);
        }
    </style>
</head>
<body>

<div class="vpn-service-container">
    
    <!-- Hero Header -->
    <header class="hero-section">
        <div class="badge-container">
            <span class="badge">PRO VPN DEVELOPER</span>
            <span class="badge green">ADMOB & IN-APP SUBSCRIPTION</span>
        </div>
        <h1 class="hero-title">Build Your High-Earning VPN Application</h1>
        <p class="hero-description">
            I will build a high-performance VPN app for you integrated with AdMob ads and monthly in-app subscriptions. Start earning revenue from free users via ads and premium users via subscriptions!
        </p>
        
        <div class="stats-box">
            🚀 <strong> Proven Experience:</strong> Developed 300+ Apps on Play Store with over 100,000+ total users.
        </div>
    </header>

    <!-- Key Features -->
    <section>
        <h2 class="section-title">⚡ Key Features of the App</h2>
        
        <div class="features-grid">
            <div class="feature-card">
                <span class="feature-icon">🌐</span>
                <span class="feature-text">Unlimited Server Addition</span>
            </div>
            <div class="feature-card">
                <span class="feature-icon">🛡️</span>
                <span class="feature-text">Fastest & Secure VPN Protocols</span>
            </div>
            <div class="feature-card">
                <span class="feature-icon">🎨</span>
                <span class="feature-text">Attention-Grabbing Simple UI</span>
            </div>
            <div class="feature-card">
