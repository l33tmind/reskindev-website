    </section>

    <!-- Admin Panel Features -->
    <section class="admin-section">
        <h2 class="section-title" style="margin-top:0;">🎛️ What the Admin Can Do</h2>
        <div class="admin-list">
            <div class="admin-item">➕ Add New Servers</div>
