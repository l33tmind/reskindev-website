<div class="arvr-profile-container">
    
    <!-- Hero Header -->
    <header class="hero-section">
        <span class="badge">7+ YEARS EXPERIENCE</span>
        <h1 class="hero-title">Senior AR/VR & Immersive App Developer</h1>
        <p class="hero-description">
