                <span class="feature-text">In-App Purchase Subscriptions</span>
            </div>
            <div class="feature-card">
                <span class="feature-icon">📢</span>
                <span class="feature-text">Banner & Interstitial Ads</span>
            </div>
            <div class="feature-card">
                <span class="feature-icon">🔗</span>
                <span class="feature-text">Ads Show on Connect & Disconnect</span>
            </div>
            <div class="feature-card">
                <span class="feature-icon">👥</span>
                <span class="feature-text">Free Users See Admob Ads</span>
            </div>
